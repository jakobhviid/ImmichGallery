<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>$(IMMICH_APP_NAME)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.igol.ImmichGallery.asset-ids</string>
			<key>UTTypeDescription</key>
			<string>Immich Gallery Asset Selection</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.data</string></array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Clicks on the desktop widget. -->
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).widget</string>
			<key>CFBundleURLSchemes</key>
			<array><string>$(IMMICH_URL_SCHEME)</string></array>
		</dict>
		<dict>
			<!-- Crosslink: links from other Immich apps (https://jakob.hviid.phd/immich-crosslink/). -->
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).crosslink</string>
			<key>CFBundleURLSchemes</key>
			<array><string>immich-crosslink</string></array>
		</dict>
	</array>
	<!-- Crosslink: the announcement other Immich apps read without starting this one. -->
	<key>ImmichCrosslink</key>
	<dict>
		<key>Version</key>
		<string>0.2</string>
		<key>Shows</key>
		<array>
			<string>asset</string>
			<string>album</string>
			<string>person</string>
			<string>place</string>
			<string>page</string>
		</array>
	</dict>
	<key>ImmichAppGroup</key>
	<string>$(IMMICH_APP_GROUP)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Self-hosted Immich servers are often reached over plain HTTP on a LAN or VPN. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- In-app updates with Sparkle: see docs/Updates.md. -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>scKrtpmMLiB4fMerYd81b/TZ8Q5WJVEz1OPG627zYzA=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Immich Gallery connects to your Immich server, which may be on your local network.</string>
</dict>
</plist>
